{
  "name": "the-danny",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write src tests scripts docs README.md PERSONALIZATION.md DEPLOYMENT.md tools/README.md *.ts *.json index.html",
    "format:check": "prettier --check src tests scripts docs README.md PERSONALIZATION.md DEPLOYMENT.md tools/README.md *.ts *.json index.html"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "maath": "0.10.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "tone": "15.1.22",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.4.1",
    "leva": "0.10.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.3",
    "vite": "^6.4.1"
  },
  "engines": {
    "node": "24.x"
  }
}
